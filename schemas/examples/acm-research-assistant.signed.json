{
  "acm_version": "0.1.0",
  "agent_id": "agent:prod:research-assistant:01",
  "display_name": "Research Assistant",
  "owner": {
    "team": "knowledge-eng",
    "principal": "owner@example.com",
    "environment": "prod"
  },
  "identity": {
    "spiffe_id": "spiffe://example.org/ns/agents/sa/research-assistant"
  },
  "tools": [
    {
      "name": "docs.search",
      "mcp_server": "mcp://docs",
      "side_effect_class": "read"
    },
    {
      "name": "ticket.comment",
      "mcp_server": "mcp://jira",
      "side_effect_class": "write-ephemeral"
    }
  ],
  "max_side_effect_class": "write-ephemeral",
  "trifecta": {
    "private_data": true,
    "untrusted_content": true,
    "external_communication": false
