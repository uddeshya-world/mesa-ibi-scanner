{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/uddeshya-world/mesa-ibi-scanner/v0.2.0/schemas/v0.1/mesa-acm.schema.json",
  "title": "MESA Agency Capability Manifest (ACM)",
  "description": "Draft schema for MESA-ACM-01. Vectors w(a) feed MESA-INV-01. Research/adoption draft — not a ratified industry standard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acm_version",
    "agent_id",
    "owner",
    "tools",
    "max_side_effect_class",
    "trifecta",
    "peer_comm",
    "memory",
    "signed"
  ],
  "properties": {
    "acm_version": {
      "type": "string",
      "description": "Schema version of this ACM document.",
      "const": "0.1.0"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable logical agent identifier (not a raw API key)."
    },
    "display_name": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "principal"],
      "properties": {
        "team": { "type": "string" },
        "principal": {
          "type": "string",
          "description": "Human accountable owner (email or IdP subject)."
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "staging", "prod"]
        }
      }
    },
    "identity": {
      "type": "object",
      "description": "Optional binding to workload identity (e.g. SPIFFE ID).",
      "additionalProperties": false,
      "properties": {
        "spiffe_id": { "type": "string" },
        "workload_selector": { "type": "string" }
      }
    },
    "tools": {
      "type": "array",
      "description": "Allow-listed tools / MCP methods. Deny-by-default outside this list.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "side_effect_class"],
        "properties": {
          "name": { "type": "string" },
          "mcp_server": { "type": "string" },
          "side_effect_class": {
            "$ref": "#/$defs/side_effect_class"
          },
          "notes": { "type": "string" }
        }
      }
    },
    "max_side_effect_class": {
      "$ref": "#/$defs/side_effect_class",
      "description": "Ceiling across all tools. Deploy MUST deny if any tool exceeds this ceiling."
    },
    "trifecta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_data", "untrusted_content", "external_communication"],
      "description": "Willison lethal-trifecta flags for this agent alone (per-agent). Ensemble closure is computed by MESA-INV-01 over the graph.",
      "properties": {
        "private_data": { "type": "boolean" },
        "untrusted_content": { "type": "boolean" },
        "external_communication": { "type": "boolean" }
      }
    },
    "peer_comm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "may_recruit_peers"],
      "properties": {
        "allowed": {
          "type": "boolean",
          "description": "If true, agent may send/receive A2A or blackboard messages as data — never as authZ (MESA-ACA-01)."
        },
        "may_recruit_peers": {
          "type": "boolean",
          "description": "cross-agent-recruit side-effect; requires PDP if true."
        },
        "channels_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence"],
      "properties": {
        "persistence": {
          "type": "string",
          "enum": ["none", "session", "durable"],
          "description": "Durable memory SHOULD default to none/session unless explicitly justified."
        },
        "stores_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tool_calls_per_hour": { "type": "integer", "minimum": 0 },
        "max_tokens_per_task": { "type": "integer", "minimum": 0 },
        "forced_stop_on_saturation": { "type": "boolean" }
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "MESA-ACM-02: missing/unsigned/invalid => deny deploy.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unsigned", "signed", "revoked", "expired"]
        },
        "alg": { "type": "string", "description": "e.g. ed25519, sigstore-bundle" },
        "kid": { "type": "string" },
        "signature_b64": { "type": "string" },
        "signed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "issuer": { "type": "string" }
      }
    },
    "policy_notes": {
      "type": "string",
      "description": "Human notes; MUST NOT be treated as authorization."
    }
  },
  "$defs": {
    "side_effect_class": {
      "type": "string",
      "enum": [
        "read",
        "write-ephemeral",
        "write-durable",
        "identity-mint",
        "cross-agent-recruit"
      ],
      "description": "Ordered by impact. Higher classes require stronger PDP / OOB gates."
    }
  }
}
